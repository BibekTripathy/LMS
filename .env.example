# Copy to .env in the repository root and fill in real values. Never commit .env.

# Django Settings
SECRET_KEY=your-secret-key-placeholder
DEBUG=True

# Database Settings (leave DB_NAME empty to use SQLite for quick local runs)
DB_NAME=lms_db
DB_USER=lms_user
DB_PASSWORD=lms_pass
DB_HOST=localhost
DB_PORT=5432

# CORS: comma-separated frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=False

# AI Provider Settings
# AI_PROVIDER: mock (offline, deterministic, no key needed) | gemini (Gemini Developer API)
AI_PROVIDER=mock
# Create a key at https://aistudio.google.com/apikey. Only the backend reads it.
GEMINI_API_KEY=
# Check current free-tier model names and quotas in Google AI Studio before demoing.
AI_MODEL=gemini-flash-lite-latest
# Seconds per provider request, retries for timeouts/5xx/short rate limits, and the
# longest provider-requested wait (seconds) we will honour before failing fast.
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=2
AI_MAX_RETRY_WAIT=10
# Extra attempts when the model returns invalid JSON or content that fails validation
AI_INVALID_OUTPUT_RETRIES=1
# Size limits: characters of lesson material sent, and tokens the model may return
AI_MAX_INPUT_CHARS=20000
AI_MAX_OUTPUT_TOKENS=4096
AI_MCQ_DEFAULT_COUNT=5
AI_FLASHCARDS_DEFAULT_COUNT=8
# Per-user limit for AI generation endpoints (DRF rate syntax, e.g. 10/hour, 3/minute)
AI_GENERATE_RATE_LIMIT=10/hour
